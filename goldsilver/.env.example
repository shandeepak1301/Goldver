# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" and never paste real credentials into this example file.

# --- Telegram (required unless you run with --dry-run or --no-telegram) ---
# Token of your existing bot, as given by @BotFather: <digits>:<secret>
TELEGRAM_BOT_TOKEN=9043659087:AAFAHlezopGcU6Fh4wTSqFFvOeZuxbYSa3k
# Target group chat ID. Groups are negative numbers; supergroups usually start with -100
TELEGRAM_CHAT_ID=-1004420718243
# Optional: true = deliver silently (no sound/vibration). Default: false
TELEGRAM_DISABLE_NOTIFICATION=false

# --- Optional tuning (defaults shown) ---
# GOLD_URL=https://www.goodreturns.in/gold-rates/chennai.html
# SILVER_URL=https://www.goodreturns.in/silver-rates/chennai.html
# OUTPUT_DIR=output
# LOG_DIR=logs
# LOG_LEVEL=INFO
# REQUEST_CONNECT_TIMEOUT=10
# REQUEST_READ_TIMEOUT=30
# REQUEST_MAX_RETRIES=3
# REQUEST_BACKOFF_SECONDS=2
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# Reject source pages whose date is older than this many days (IST). Default: 1
